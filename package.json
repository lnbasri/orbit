{
  "name": "ppme-registration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "setup:local": "node -e \"require('fs').existsSync('.dev.vars')||require('fs').copyFileSync('.dev.vars.example','.dev.vars')\" && npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate:local",
    "cron:local": "curl -s \"http://localhost:5173/cdn-cgi/handler/scheduled?cron=*/5+*+*+*+*\"",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate:test": "wrangler d1 migrations apply DB --remote --env test",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:production": "node scripts/deploy.mjs production",
    "deploy:production-admin": "node scripts/deploy.mjs production-admin",
    "deploy:test": "node scripts/deploy.mjs test",
    "deploy:test-admin": "node scripts/deploy.mjs test-admin",
    "deploy:test-checkin": "node scripts/deploy.mjs test-checkin",
    "deploy:production-checkin": "node scripts/deploy.mjs production-checkin"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "isbot": "^5.1.36",
    "jose": "^6.2.17",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "recharts": "3.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
