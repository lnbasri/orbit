# Copy to .dev.vars for local development; .dev.vars is git-ignored.
# Local sign-in can be skipped with DEV_ADMIN_EMAIL when APP_ENV=development.
DEV_ADMIN_EMAIL=admin@example.com

# Cloudflare Turnstile's always-pass test secret for local sign-in.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Seed administrator access on first local use (comma-separated).
ADMIN_EMAILS=admin@example.com

# Optional external email sign-in. Keep empty for local development.
RESEND_API_KEY=
GOOGLE_CLIENT_SECRET=
